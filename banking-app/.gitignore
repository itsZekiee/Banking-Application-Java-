# ==============================================================================
# Git Ignore for Banking Application (Full-Stack Multi-Client Project)
# Backend (Java/Maven), Web (React), Mobile (React Native)
# ==============================================================================

# --- Root & General ---
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.swp
*~

# --- IDEs and Editors ---
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
*.sublime-project
*.sublime-workspace

# --- Java & Maven (Backend) ---
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
backend/.mvn/wrapper/maven-wrapper.jar

# --- Node & JavaScript (Web & Mobile) ---
node_modules/
web/node_modules/
mobile/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# --- Frontend Build Artifacts (Web) ---
web/build/
web/dist/
.env.local
.env.development.local
.env.test.local
.env.production.local
web/.env.local
web/.env.development.local
web/.env.test.local
web/.env.production.local

# --- React Native & Mobile Artifacts (Android / iOS) ---
mobile/.expo/
mobile/.expo-shared/
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/build/
mobile/android/.idea/
mobile/android/*.iml
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/build/
mobile/ios/*.xcworkspace/
mobile/ios/*.xcuserdata/
mobile/ios/Podfile.lock

# --- Environment & Secret Variables ---
.env
web/.env
mobile/.env
*.env.vault
